
; ******** Source: 64moderom.asm
     1                          ; 64moderom.asm - updated keyboard driver for 64 mode of 128 to support cursor and keypad keys
     2                          ; updates are derived from Commodore ROM keyboard driver, enhanced to support up to 87 keys
     3                          ;
     4                          ; revisions Copyright (c) 2026 by David R. Van Wagner
     5                          ; MIT LICENSE
     6                          ;
     7                          ; github.com/davervw/c-keymaps
     8                          ; davevw.com
     9                          ;
    10                          ; compiled bytes have been manually encoded into "64mode patch" program which patches a C64 by modifying ROMs into RAM
    11                          ; alternatively see patches which can be applied to BASIC/KERNAL ROMs with xxd (see README.md)
    12                          
    13                          * = $033C   ; tape buffer, temporary for copying ROMs to RAM
    14  033c a900               LDA #$00
    15  033e a220               LDX #$20
    16  0340 a0a0               LDY #$A0
    17  0342 204b03             JSR $034B
    18  0345 a900               LDA #$00
    19  0347 a220               LDX #$20
    20  0349 a0e0               LDY #$E0
    21  034b 85fb               STA $FB
    22  034d 84fc               STY $FC
    23  034f a8                 TAY
    24  0350 b1fb               LDA ($FB),Y
    25  0352 91fb               STA ($FB),Y
    26  0354 c8                 INY
    27  0355 d0f9               BNE $0350
    28  0357 e6fc               INC $FC
    29  0359 ca                 DEX
    30  035a d0f4               BNE $0350
    31  035c 60                 RTS
    32                          
    33                          * = $BF4E   ; to BF70
    34                          init_scan:
    35  bf4e a940               LDA #$40    ; no key
    36  bf50 85cb               STA $CB     ; scan code
    37  bf52 a000               LDY #$00    ; zero, for shift state, scancode counter, and all standard keyboard rows
    38  bf54 8c8d02             STY $028D   ; shift state 3 bits Control(2)=4 CBM(1)=2 Shift(0)=1
    39  bf57 a9f8               LDA #$F8    ; lower 3 bits cleared
    40  bf59 a2ff               LDX #$FF    ; lower 3 bits are extended C128 keyboard row for later
    41  bf5b 8d2fd0             STA $D02F   ; all extended keyboard rows selected
    42  bf5e 8c00dc             STY $DC00   ; all standard keyboard rows selected
    43                          reset_table:
    44  bf61 a981               LDA #$81    ; low unshifted table in ROM
    45  bf63 85f5               STA $F5     ; key table ptr
    46  bf65 a9eb               LDA #$EB    ; high unshifted table in ROM
    47  bf67 85f6               STA $F6     ; key table ptr + 1
    48  bf69 a9fe               LDA #$FE    ; start with bit 1 clear for later
    49  bf6b ec01dc             CPX $DC01   ; compare columns with #$FF - set Z if no keys pressed
    50  bf6e 60                 RTS
    51  bf6f ea                 NOP
    52  bf70 ea                 NOP
    53                          
    54                          * = $E4B7   ; to E4D2
    55                          xlat_extended:
    56  e4b7 1b10403b0b183840   !byte  27, 16, 64, 59, 11, 24, 56, 64
    57  e4bf 282b400113200840   !byte  40, 43, 64,  1, 19, 32,  8, 64
    58  e4c7 232c8707820240aa   !byte  35, 44,135,  7,130,  2, 64, 170
    59  e4cf aaaaaaaa           !byte 170,170,170,170
    60                          
    61                          * = $EA87   ; to EADF
    62  ea87 204ebf             JSR init_scan ; some code patched in BASIC ROM
    63  ea8a f06f               BEQ $EAFB   ; branch if no key press
    64  ea8c 86f5               STX $F5     ; save keyboard row extended 3-bits
    65                          --
    66  ea8e 8e2fd0             STX $D02F   ; set extended 3-bits keyboard row
    67  ea91 8d00dc             STA $DC00   ; set lower 8-bits keyboard row
    68  ea94 48                 PHA         ; save keyboard row lower 8-bits
    69                          - 
    70  ea95 ad01dc             LDA $DC01   ; load columns
    71  ea98 cd01dc             CMP $DC01   ; stable?
    72  ea9b d0f8               BNE -       ; repeat if key bounce
    73  ea9d a208               LDX #$08    ; number of columns to read
    74                          -
    75  ea9f 4a                 LSR         ; shift low bit into C
    76  eaa0 b017               BCS +++     ; branch if not this key 
    77  eaa2 48                 PHA         ; save keyboard columns read (shifted)
    78  eaa3 b981eb             LDA $EB81,Y ; get unshifted key mapping
    79  eaa6 c905               CMP #$05    ; not shift code?
    80  eaa8 b00c               BCS +       ; branch if not shift code
    81  eaaa c903               CMP #$03    ; STOP key?
    82  eaac f008               BEQ +       ; branch if STOP (not shift code)
    83  eaae 0d8d02             ORA $028D   ; combine with shift code
    84  eab1 8d8d02             STA $028D   ; store shift code
    85  eab4 1002               BPL ++      ; unconditional branch, don't store scancode
    86                          +
    87  eab6 84cb               STY $CB     ; found keypress that wasn't shift key, store it
    88                          ++
    89  eab8 68                 PLA         ; restore keyboard columns read
    90                          +++
    91  eab9 c8                 INY         ; increment working scancode count
    92  eaba ca                 DEX         ; finished one column
    93  eabb d0e2               BNE -       ; loop until read all columns
    94  eabd 68                 PLA         ; restore keyboard row
    95  eabe 38                 SEC         ; shifted in bit needs to be set
    96  eabf 2a                 ROL         ; next row, shift bits left
    97  eac0 26f5               ROL $F5     ; shift extended bits left
    98  eac2 a6f5               LDX $F5     ; read result
    99  eac4 e0f7               CPX #$F7    ; check if out of range of 11-bits
   100  eac6 d0c6               BNE --      ; branch if limit not reached - scan more keyboard rows
   101  eac8 a4cb               LDY $CB     ; retrieve any scancode
   102  eaca c041               CPY #$41
   103  eacc 900c               BCC ++      ; branch if less than 65
   104  eace b976e4             LDA xlat_extended-$41, Y ; translate extended keys (and no key, note HELP not mapped with this implementation)
   105  ead1 1005               BPL +
   106  ead3 ee8d02             INC $028D   ; assume it was zero
   107  ead6 293f               AND #$3F
   108                          +
   109  ead8 85cb               STA $CB     ; store translated scancode
   110                          ++
   111  eada 2061bf             JSR reset_table
   112  eadd 6c8f02             JMP ($028F) ; key is pressed, process it including getting proper shift table pointer
   113                          ; * = $EAE0
   114                          
   115                          ; EAFB no key press
